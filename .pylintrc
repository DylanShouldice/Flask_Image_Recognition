[MAIN]
py-version=3.10
ignore=CVS,.venv,__pycache__,.git,.idea
ignore-paths=^.*/\.venv/.*$,^.*/__pycache__/.*$
ignore-patterns=^\.#
recursive=yes
jobs=1
fail-under=10

[BASIC]
docstring-min-length=-1
no-docstring-rgx=^_

[FORMAT]
max-line-length=100
indent-string='    '
expected-line-ending-format=CRLF

[IMPORTS]
known-first-party=app,model
known-third-party=flask,keras,numpy,PIL,pytest

[MESSAGES CONTROL]
disable=raw-checker-failed,
        bad-inline-option,
        locally-disabled,
        file-ignored,
        suppressed-message,
        useless-suppression,
        deprecated-pragma,
        use-symbolic-message-instead

[SIMILARITIES]
min-similarity-lines=6

[TYPECHECK]
generated-members=

[REPORTS]
reports=yes
score=yes
msg-template={path}:{line}:{column}: {msg_id}: {msg} ({symbol})
